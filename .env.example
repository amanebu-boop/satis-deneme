# Placeholder template only. Never put real credentials in this file or commit them.
# Copy to a local .env only for local development; production values belong in a secret manager.
# No authentication routes are implemented yet; these values do not enable login by themselves.
GOOGLE_OIDC_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OIDC_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OIDC_REDIRECT_URI=https://replace-with-your-domain.example/auth/callback
SALES_ALLOWED_GOOGLE_SUB=replace-with-authorized-google-oidc-sub
SALES_SESSION_SECRET=replace-with-at-least-32-random-bytes
