# Local development only. Never commit real credentials.
# SQLite remains the default when DATABASE_URL is not set.
# DATABASE_URL=postgresql+psycopg://sales:change-me@localhost:5432/sales
# SALES_STORAGE_BACKEND=local

# RustFS / S3-compatible storage (set only when SALES_STORAGE_BACKEND=s3)
# SALES_STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=sales-documents
# S3_ACCESS_KEY=replace-me
# S3_SECRET_KEY=replace-me
# S3_USE_SSL=false

# Docker Compose secrets (all values must be generated before starting the stack)
POSTGRES_DB=sales
POSTGRES_USER=sales
POSTGRES_PASSWORD=replace-with-a-long-random-password
RUSTFS_IMAGE=rustfs/rustfs-x86-musl:v2.3.1
RUSTFS_ACCESS_KEY=replace-with-a-long-random-access-key
RUSTFS_SECRET_KEY=replace-with-a-long-random-secret-key
S3_BUCKET=sales-documents

BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-encryption-passphrase
